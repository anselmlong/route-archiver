[Unit]
Description=NUS USC Routes — telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/route-archiver
EnvironmentFile=/home/ubuntu/route-archiver/.env
ExecStart=/home/ubuntu/route-archiver/venv/bin/python3 /home/ubuntu/route-archiver/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
