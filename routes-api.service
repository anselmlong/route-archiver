[Unit]
Description=NUS USC Routes — mini-app API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/route-archiver
ExecStart=/home/ubuntu/route-archiver/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8160
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
